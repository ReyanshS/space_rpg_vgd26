script = ExtResource("10_beat")
trigger = 0
lines = PackedStringArray("See that battery? It\'s a power cell, and it\'s still got juice in it.", "Grab it while you\'re holding the wire. It adds half a second to your timer.", "Keep them and they\'re yours to spend. Enough of them buys a longer wire.")
