[node name="Intro" type="Marker2D" parent="Story" unique_id=1199686717]
position = Vector2(208, 688)
script = ExtResource("10_beat")
trigger = 0
lines = PackedStringArray("Oh good, you\'re awake. I\'m PIP. I keep this ship running. Usually.", "A solar storm fried the main power. I really don\'t like the dark.", "Grab the wire on the yellow pad and carry it to the blue one.")
pause_game = true

[node name="CellIntro" type="Marker2D" parent="Story" unique_id=1843054413]
position = Vector2(304, 656)
script = ExtResource("10_beat")
trigger = 0
lines = PackedStringArray("See that battery? It\'s a power cell, and it\'s still got juice in it.", "Grab it while you\'re holding the wire. It adds half a second to your timer.", "Keep them and they\'re yours to spend. Enough of them buys a longer wire.")
pause_game = true
point_here = true

[node name="CellTip" type="Marker2D" parent="Story" unique_id=1475964606]
position = Vector2(240, 688)
script = ExtResource("10_beat")
trigger = 9
lines = PackedStringArray("Batteries only plug into the live wire. Grab the wire first.")

[node name="Room1Done" type="Marker2D" parent="Story" unique_id=130734455]
position = Vector2(176, 688)
script = ExtResource("10_beat")
trigger = 2
lines = PackedStringArray("Lights. I can see again. Well, my cameras can.")

[node name="Room2Done" type="Marker2D" parent="Story" unique_id=31141376]
position = Vector2(176, 400)
script = ExtResource("10_beat")
trigger = 2
lines = PackedStringArray("A node tops your timer back up, and holds it while you stand on it.")

[node name="Room3Intro" type="Marker2D" parent="Story" unique_id=372436841]
position = Vector2(688, 240)
script = ExtResource("10_beat")
lines = PackedStringArray("Purple posts are poles. Walk round one and the wire wraps round it.", "That\'s how you get the wire round a corner. Poles don\'t add time.", "Wrapped the wrong way? Walk back and it comes off again.")
pause_game = true

[node name="Room3Done" type="Marker2D" parent="Story" unique_id=450323481]
position = Vector2(656, 208)
script = ExtResource("10_beat")
trigger = 2
lines = PackedStringArray("Nice. Round the pillars and in.")

[node name="Room4Intro" type="Marker2D" parent="Story" unique_id=1388293789]
position = Vector2(1648, 1136)
script = ExtResource("10_beat")
lines = PackedStringArray("Careful. Those red grates are live. Step on one and you get zapped.", "The wire won\'t cross them either, so plan your way round first.")
pause_game = true

[node name="GeneratorIntro" type="Marker2D" parent="Story" unique_id=877755260]
position = Vector2(624, 1296)
script = ExtResource("10_beat")
lines = PackedStringArray("This is the generator room. It\'s three machines in one.", "Every time you power one, the cargo lifts drop and the room changes.", "So have a look around before you grab the next wire.")
pause_game = true

[node name="GeneratorC" type="Marker2D" parent="Story" unique_id=1076282822]
position = Vector2(1136, 1520)
script = ExtResource("10_beat")
lines = PackedStringArray("These grates blink on and off. Lit ones zap your boots. The wire\'s fine.", "The light moves like a wave. Walk in the dark gap right behind it.", "The node in the middle holds the clock for a bit. Wait there for the gap.")
pause_game = true

[node name="ShipLightsUp" type="Marker2D" parent="Story" unique_id=2024546782]
position = Vector2(944, 880)
script = ExtResource("10_beat")
trigger = 10
lines = PackedStringArray("That\'s the whole engineering deck back on.", "Look at that. Every single light.")

