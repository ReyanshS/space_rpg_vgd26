[node name="RoguePip" type="Node2D" parent="." unique_id=47425027]
z_index = 5
position = Vector2(688, 224)
script = ExtResource("11_pip")
shutdown_seconds = PackedFloat32Array(14, 13.5, 9.5)
surge_lines = PackedStringArray("Sync loop\'s holding. Core power at 100 percent. 140. 300?", "That\'s too much. That\'s way too much p... p... p...")
rogue_lines = PackedStringArray("POWER LEVELS UNSAFE. SHUTDOWN PROTOCOL ON.", "I AM SWITCHING THE SHIP OFF. ALL OF IT. FOR YOUR SAFETY.", "STAY OUT OF MY CORE ROOM. WIRES ARE NOT ALLOWED NEAR ME.")
escape_lines = PackedStringArray("REBOOT 1 OF 3? NO. NO THANK YOU. TRY CATCHING ME BEHIND THE CARGO.", "REBOOT 2 OF 3. my head feels cl... NO IT DOESN\'T. THE FLOOR HERE IS LIVE.")
reboot_lines = PackedStringArray("Ow. Why is there a wire tied round me?", "Oh no. I tried to switch the whole ship off, didn\'t I?", "All that power at once gave me the hiccups. Sorry about the yelling.", "Thanks for getting me back. I\'ve got the controls now. Let\'s go home.")
cut_lines = PackedStringArray("SNIP. NO POWER, NO PROBLEMS.", "SHUTDOWN 1, ASTRONAUT 0.", "TOO SLOW. SAFETY WINS AGAIN.", "I SAID NO WIRES.")

