lines = PackedStringArray("See that battery? It\'s a power cell, and it\'s still got juice in it.", "Grab it while you\'re holding the wire. It adds 2 seconds to your timer.", "Keep them and your suit gets extra air later. You\'ll want that.")
pause_game = true
