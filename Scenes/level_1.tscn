script = ExtResource("10_beat")
trigger = 0
lines = PackedStringArray("Oh! You\'re awake! I\'m PIP, the ship\'s maintenance AI.", "A solar storm knocked out the power. The whole ship is dark... I don\'t like the dark.", "Carry the live wire from the yellow START pad to the blue GOAL to power each room.")
pause_game = true

[node name="CellIntro" type="Marker2D" parent="Story" unique_id=1843054413]
position = Vector2(304, 624)
script = ExtResource("10_beat")
trigger = 0
lines = PackedStringArray("See that little battery with the lightning bolt? That\'s a POWER CELL - and it\'s empty.", "Run through it while you\'re carrying the live wire and it charges up!", "Every cell you keep gives your space suit {o2_per_cell} more seconds of air later. Get them all for a star!")
pause_game = true
point_here = true

[node name="CellTip" type="Marker2D" parent="Story" unique_id=1475964606]
