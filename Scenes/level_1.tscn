[node name="GeneratorIntro" type="Marker2D" parent="Story" unique_id=877755260]
position = Vector2(528, 1072)
script = ExtResource("10_beat")
lines = PackedStringArray("This is the generator room. It\'s three machines in one.", "Every time you power one, the cargo lifts drop and the room changes.", "So have a look around before you grab the next wire.")
