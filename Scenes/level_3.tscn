script = ExtResource("10_beat")
trigger = 0
lines = PackedStringArray("Core deck. This is where I live. Well, where my brain lives.", "The whole ship runs on your power now. My core just needs syncing to it.", "See that pylon? Loop the live wire all the way round it to sync it.")
