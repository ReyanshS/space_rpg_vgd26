[node name="LoopFail" type="Marker2D" parent="Story"]
position = Vector2(240, 144)
script = ExtResource("10_beat")
trigger = 5
lines = PackedStringArray("A straight wire can't go round anything. Use the nodes as corners.")

[node name="CoreIntro" type="Marker2D" parent="Story"]
position = Vector2(560, 192)
script = ExtResource("10_beat")
speaker = "P!P"
lines = PackedStringArray("OH. IT'S YOU. THE ONE WHO KEEPS SWITCHING THINGS ON.", "BRING A WIRE NEAR ME AND MY RED LIGHTS START COUNTING.", "WHEN THEY'RE ALL LIT, I CUT YOUR WIRE. SIMPLE. SAFE.")
pause_game = true

[node name="CoreWhisper" type="Marker2D" parent="Story"]
position = Vector2(688, 156)
script = ExtResource("10_beat")
lines = PackedStringArray("psst. it's me. the real me. loop the wire round my core, like the pylon.", "every loop reboots me a little. three should do it. be quick.")
pause_game = true
point_here = true

[node name="CoreFail" type="Marker2D" parent="Story"]
position = Vector2(592, 192)
script = ExtResource("10_beat")
trigger = 5
lines = PackedStringArray("his lights only count while you hold the wire. plan the loop, then grab it.")

[node name="CargoWhisper" type="Marker2D" parent="Story"]
position = Vector2(1120, 320)
script = ExtResource("10_beat")
lines = PackedStringArray("he's behind the cargo now. your loop has to go round the crates as well.")

[node name="GratesWhisper" type="Marker2D" parent="Story"]
position = Vector2(1056, 576)
script = ExtResource("10_beat")
lines = PackedStringArray("the grates flash on and off in a wave. cross while they're dark.", "the wire's fine over them. it's only your boots that get zapped.")

[node name="GratesFail" type="Marker2D" parent="Story"]
position = Vector2(1088, 576)
script = ExtResource("10_beat")
trigger = 5
lines = PackedStringArray("wait on a node till the grates go dark. nodes pause the wire timer.")

[node name="ShipLightsUp" type="Marker2D" parent="Story"]
